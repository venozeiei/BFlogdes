local lastHatchTry = 0

local function baseNeedsWork()
	local ok, data = pcall(Save.Get, LocalPlayer, false)
	if not ok or type(data) ~= "table" then return false end

	for _, r in pairs(data.EggInventory or {}) do
		if type(r) == "table" and r.Placement == nil then return true end
	end

	if Config.AutoSell then
		local list = sellCandidates()
		if #list > 0 then return true end
	end

	if Config.AutoUpgrade then
		local nextCfg = Bases.BASES[(data.BaseUpgradeLevel or 0) + 1]
		if nextCfg and (tonumber(data.Money) or 0) >= (nextCfg.Cost or math.huge) then
			return true
		end
	end

	if Config.AutoHatch then
		local base = math.max(5, tonumber(Config.HatchRetryEvery) or 30)
		local every = math.min(300, base * math.max(1, Hub.hatchBackoff or 1))
		if os.clock() - lastHatchTry >= every then
			for _, r in pairs(data.EggInventory or {}) do
				if type(r) == "table" and r.Placement ~= nil then
					lastHatchTry = os.clock()
					return true
				end
			end
		end
	end

	return false
end

Hub.rideTreadmill = function()
	if Config.RideTreadmill == false then return false end

	local plot, slot = myPlot()
	if not plot or not slot then
		Hub.RideNoSlot = (Hub.RideNoSlot or 0) + 1
		Hub.RideBail = "หาแปลงไม่เจอ"
		return false
	end
	Hub.RideSlotUsed = slot

	local plotAt
	do
		local tb = plot:FindFirstChild("TreadmillBottom")
		if tb and tb:IsA("BasePart") then
			plotAt = tb.Position
		else
			local ok, pv = pcall(function() return plot:GetPivot().Position end)
			plotAt = ok and pv or nil
		end
	end

	local belt, spotOverride, render
	do
		local folder = workspace:FindFirstChild("__ClientTreadmillRenders")
		local r = folder and folder:FindFirstChild("TreadmillRender_" .. slot)
		local bb = r and r:FindFirstChild("BoundingBoxPart")

		local tb = plot:FindFirstChild("TreadmillBottom")
		if tb and tb:IsA("BasePart") then
			belt = tb
			spotOverride = Vector3.new(
				tb.Position.X,
				tb.Position.Y + tb.Size.Y / 2 + 3.09,
				tb.Position.Z)
		end
		render = r

		if bb and bb:IsA("BasePart") and belt then
			Hub.RideBoxGap = (Vector3.new(bb.Position.X, 0, bb.Position.Z)
				- Vector3.new(belt.Position.X, 0, belt.Position.Z)).Magnitude
			if Hub.RideBoxGap > 20 then
				Hub.RideWrongBox = (Hub.RideWrongBox or 0) + 1
			end
		end
	end
	if not belt then

		for _ = 1, 6 do
			task.wait(0.5)
			local folder = workspace:FindFirstChild("__ClientTreadmillRenders")
			local r = folder and folder:FindFirstChild("TreadmillRender_" .. slot)
			local tb = plot:FindFirstChild("TreadmillBottom")
			if tb and tb:IsA("BasePart") then
				belt = tb
				spotOverride = Vector3.new(
					tb.Position.X,
					tb.Position.Y + tb.Size.Y / 2 + 3.09,
					tb.Position.Z)
				break
			end
		end
	end
	if not belt then
		Hub.RideNoBelt = (Hub.RideNoBelt or 0) + 1
		Hub.RideBail = "ไม่เจอสายพาน"
		return false
	end

	local spot = spotOverride or (belt.Position + Vector3.new(0, 3.09, 0))

	Hub.RideLeaving = nil
	Hub.Riding = true
	Hub.RideStart = os.clock()

	local arrived = false
	for _ = 1, 3 do
		if move(spot) then arrived = true break end
		task.wait(0.3)
	end
	if not arrived then
		Hub.RideMoveFail = (Hub.RideMoveFail or 0) + 1
		Hub.RideBail = "เดินทางไปไม่ถึง"
		Hub.Riding = false
		return false
	end

	pcall(Hub.pinRelease)
	do
		local _, h0 = char()
		if h0 then
			pcall(function()
				h0.CFrame = CFrame.new(spot)
				h0.AssemblyLinearVelocity = Vector3.zero
			end)
			Hub.RidePlaced = (Hub.RidePlaced or 0) + 1
		end
	end
	task.wait(0.4)

	local net = Hub.NetRoot
	local rf = Hub.remote(Hub.TREAD_EQUIP)

	if Hub.TreadmillActive == true then
		local uq = Hub.remote(TREAD_UNEQUIP)
		if uq and uq:IsA("RemoteFunction") then
			Hub.rq(function() return uq:InvokeServer() end)
			Hub.RidePreClear = (Hub.RidePreClear or 0) + 1
			task.wait(0.3)
		end
	end

	local function tryMount(rounds)
	local mountedNow = false
	for try = 1, (rounds or 4) do
		local _, h = char()
		if not h then break end

		local function reseat()
			pcall(function()
				h.CFrame = CFrame.new(spot)
				h.AssemblyLinearVelocity = Vector3.zero
			end)
		end
		local function rayHit()
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Include
			rp.FilterDescendantsInstances = { belt, render }
			return workspace:Raycast(h.Position, Vector3.new(0, -8, 0), rp)
		end

		reseat()
		task.wait(0.15)
		local seen = rayHit()
		if not seen then

			reseat()
			seen = rayHit()
			Hub.RideReseat = (Hub.RideReseat or 0) + 1
		end
		Hub.RideRayHit = seen and seen.Instance.Name or "ไม่โดน"
		if not seen then
			Hub.RideRayMiss = (Hub.RideRayMiss or 0) + 1
		elseif rf and rf:IsA("RemoteFunction") then
			local res = Hub.rq(function() return rf:InvokeServer() end)
			local ok = res ~= nil
			Hub.RideEquipRes = tostring(res)
			if ok and res == true then
				mountedNow = true
				Hub.RideOnBelt = (Hub.RideOnBelt or 0) + 1
				break
			end
			Hub.RideEquipFail = (Hub.RideEquipFail or 0) + 1

			if Hub.TreadmillActive == true then
				mountedNow = true
				Hub.RideAlready = (Hub.RideAlready or 0) + 1
				Hub.RideOnBelt = (Hub.RideOnBelt or 0) + 1
				break
			end

			local uq = Hub.remote(TREAD_UNEQUIP)
			if uq and uq:IsA("RemoteFunction") then
				Hub.rq(function() return uq:InvokeServer() end)
			end
		end
		task.wait(1.3)
	end
	return mountedNow
	end

	local mounted = tryMount(4)
	if not mounted then
		Hub.RideNoMount = (Hub.RideNoMount or 0) + 1
	end
	do
		local _, h = char()
		if h then Hub.RideGap = (h.Position - spot).Magnitude end
	end

	Hub.RideLog = {}
	task.spawn(function()
		local ls = LocalPlayer:FindFirstChild("leaderstats")
		local sv = ls and ls:FindFirstChild("Speed")
		local s0 = sv and tonumber(sv.Value) or 0
		for i = 1, 20 do
			task.wait(0.5)
			local _, h = char()
			if not h then break end
			Hub.RideLog[#Hub.RideLog + 1] = ("%.1f d%.1f +%d pin%s"):format(
				i * 0.5, (h.Position - spot).Magnitude,
				(sv and tonumber(sv.Value) or 0) - s0,
				(Hub.PinPos and os.clock() < (Hub.PinUntil or 0)) and "ON" or "off")
		end
	end)

	local function readSpeed()
		local ls = LocalPlayer:FindFirstChild("leaderstats")
		local sp = ls and ls:FindFirstChild("Speed")
		return sp and tonumber(sp.Value) or nil
	end
	Hub.RideSpeed0 = readSpeed()

	local leaveAt = tonumber(Config.PreResetHold) or 20
	local t0 = os.clock()
	Hub.RideStarted = (Hub.RideStarted or 0) + 1

	do
		local function readSpeed()
			local ls = LocalPlayer:FindFirstChild("leaderstats")
			local sp = ls and ls:FindFirstChild("Speed")
			return sp and tonumber(sp.Value) or nil
		end

		pcall(Hub.pinRelease)
		local base = readSpeed()
		local w0 = os.clock()
		while os.clock() - w0 < 8 do
			Hub.Phase = "รออนิเมชันขึ้นลู่วิ่ง"
			task.wait(0.3)
			local now = readSpeed()
			if base and now and now > base then
				Hub.RideConfirmed = (Hub.RideConfirmed or 0) + 1
				break
			end

			local _, hc = char()
			if hc then Hub.RideGap = (hc.Position - spot).Magnitude end
		end
		if not Hub.RideConfirmed or Hub.RideConfirmed == 0 then
			Hub.RideNoGain = (Hub.RideNoGain or 0) + 1
		end
	end

	Hub.RideBail = nil
	Hub.RideCheckAt, Hub.RideCheckSpeed, Hub.RideRwAt = nil, nil, nil
	while Config.Running and alive() do
		local left = Hub.nightIn() or secondsToReset()

		if not Config.RunFirst and left ~= nil and left <= leaveAt then Hub.RideBail = "ถึงเวลารีเซ็ต" break end

		if left == nil and os.clock() - t0 > 240 then Hub.RideBail = "อ่านเวลาไม่ได้" break end

		if Config.RunFirst and (not Hub.RideScoutAt
			or os.clock() - Hub.RideScoutAt >= (tonumber(Config.RunFirstScan) or 4)) then
			Hub.RideScoutAt = os.clock()
			local egg, rate = findEgg(Config.Area)
			if egg and Hub.beatsPen(rate) then
				Hub.RideBail = "เจอไข่แพงกว่าคอก - ลงไปเก็บ"
				Hub.RunFirstHop = (Hub.RunFirstHop or 0) + 1
				break
			end
		end

		if not Config.RunFirst and os.clock() - (Hub.RideAfkAt or -1e9) >= (tonumber(Config.AfkMoveEvery) or 90) then
			Hub.RideAfkAt = os.clock()
			Hub.RideBail = "ขยับกัน AFK"
			break
		end

		if left == nil then
			if not Hub.RideRwAt or os.clock() - Hub.RideRwAt >= 10 then
				Hub.RideRwAt = os.clock()
				if Hub.resetWindow() then
					Hub.RideBail = "อ่านเวลาไม่ได้ - ใช้ธงกล่องแทน"
					break
				end
			end
		end

		do
			local ls2 = LocalPlayer:FindFirstChild("leaderstats")
			local sv2 = ls2 and ls2:FindFirstChild("Speed")
			local now = sv2 and tonumber(sv2.Value)

			local drifted = false
			do
				local _, hc = char()
				if hc then
					Hub.RideNowGap = (hc.Position - spot).Magnitude
					drifted = Hub.RideNowGap > 5
				end
			end

			if now then
				if Hub.RideWatchVal == nil or now > Hub.RideWatchVal then
					Hub.RideWatchVal, Hub.RideWatchAt = now, os.clock()
				end

				local stalled = os.clock() - (Hub.RideWatchAt or 0) >= 6
				if stalled or drifted then
					Hub.RideStalled = (Hub.RideStalled or 0) + 1
					Hub.Phase = drifted and "ไถลออกจากสายพาน - ขึ้นใหม่"
						or "speed หยุดเดิน - ขึ้นลู่วิ่งใหม่"
					if tryMount(2) then
						Hub.RideRemount = (Hub.RideRemount or 0) + 1
					end
					Hub.RideWatchVal, Hub.RideWatchAt = nil, os.clock()
				end
			end
		end

		if Config.AutoHatch ~= false then
			if not Hub.RideHatchAt or os.clock() - Hub.RideHatchAt >= 15 then
				Hub.RideHatchAt = os.clock()
				local before = Stats.hatched
				pcall(hatchReadyEggs, nil, true)
				local n = Stats.hatched - before
				if n > 0 then
					Hub.RideHatched = (Hub.RideHatched or 0) + n

					if equipBestF then
						pcall(function() equipBestF:InvokeServer() end)
						clearPetsCache()
					end
				end
			end
		end

		if Config.RideBreak ~= false and Hub.RideStart
			and os.clock() - Hub.RideStart >= 15 then
			if not Hub.RideEggAt
				or os.clock() - Hub.RideEggAt >= (tonumber(Config.RideBreakEvery) or 10) then
				Hub.RideEggAt = os.clock()

				local need = tonumber(Config.RideBreakAt) or 0
				if need <= 0 then

					local pets = myPets()
					local weak = pets and pets[#pets]
					need = math.max((weak and tonumber(weak.mps)) or 0,
						tonumber(Config.RideBreakMin) or 1e6)
				end

				local okr, ranked = pcall(rankedEggs, Config.Area)
				local top = okr and ranked and ranked[1]
				if top and (tonumber(top.rate) or 0) >= need then
					Hub.RideBreaks = (Hub.RideBreaks or 0) + 1
					Hub.RideBail = ("เจอไข่ใหญ่ %s/s (เกณฑ์ %s)")
						:format(comma(math.floor(top.rate)), comma(math.floor(need)))
					break
				end
			end
		end

		Hub.Phase = ("ยืนวิ่งสะสม speed%s")
			:format((Hub.RideHatched or 0) > 0 and (" · ฟักระหว่างวิ่ง " .. Hub.RideHatched) or "")

		task.wait(1)
	end

	do
		local lf = (Hub.nightIn and Hub.nightIn()) or (secondsToReset and secondsToReset())
		Hub.RideExits = Hub.RideExits or {}
		Hub.RideExits[#Hub.RideExits + 1] = ("%s @เหลือ %s วิ"):format(
			tostring(Hub.RideBail), tostring(lf and math.floor(lf) or "?"))

		while #Hub.RideExits > 10 do table.remove(Hub.RideExits, 1) end
	end

	Hub.RideLeaving = true
	Hub.Riding = false
	pcall(Hub.pinRelease)

	Hub.Phase = "ออกจากลูกวิ่ง - กลับไปรอที่จุดกลาง"

	for _ = 1, 3 do
		pcall(Hub.watchTreadmill)
		local done = Hub.clearTreadmillState(true)
		if done and Hub.TreadmillActive ~= true then break end
		task.wait(0.25)
	end
	Hub.RideEnded = (Hub.RideEnded or 0) + 1
	do
		local ls = LocalPlayer:FindFirstChild("leaderstats")
		local sp = ls and ls:FindFirstChild("Speed")
		local now = sp and tonumber(sp.Value)
		if now and Hub.RideSpeed0 then
			Hub.RideGain = (Hub.RideGain or 0) + (now - Hub.RideSpeed0)
			Hub.RideSpeedNow = now
		end
	end
	Hub.RideLeaving = nil
	move(warpHome)
	return true
end

local function warpCycle()
	if not waitForRespawn() then
		enteredZone = false
		return "ตายแล้วไม่เกิดใหม่"
	end

	local _, hrp = char()
	if not hrp then return "ไม่มีตัวละคร" end

	if warpHome and (tonumber(Config.WarpHomeX) or tonumber(Config.WarpHomeZ)) then
		local wx = tonumber(Config.WarpHomeX) or warpHome.X
		local wz = tonumber(Config.WarpHomeZ) or warpHome.Z
		if math.abs(wx - warpHome.X) > 0.5 or math.abs(wz - warpHome.Z) > 0.5 then
			warpHome = Vector3.new(wx, LANE_Y, wz)
			log(("ย้ายจุดกลางเป็น x%d z%d"):format(math.floor(wx), math.floor(wz)))
		end
	end

	if not warpHome then

		warpHome = Vector3.new(
			tonumber(Config.WarpHomeX) or Hub.HOME.X,
			Hub.HOME.Y,
			tonumber(Config.WarpHomeZ) or Hub.pickLaneZ())
		log(("จุดยืนกลาง SAFE ZONE: x%d z%d"):format(
			math.floor(warpHome.X), math.floor(warpHome.Z)))
	end

	if warpHome and not tonumber(Config.WarpHomeZ) then
		local lz = Hub.pickLaneZ()
		if math.abs(lz - warpHome.Z) > 0.5 then
			warpHome = Vector3.new(warpHome.X, warpHome.Y, lz)
		end
	end

	local holdSecs = tonumber(Config.PreResetHold) or 10
	if holdSecs > 0 and Config.MoveMode == "warp" then

		local nleft = Hub.nightIn()
		local left = nleft or secondsToReset()

		local GUI_TRUST_WINDOW = 45
		local timeNear = (left ~= nil and left <= holdSecs)
		local guiNear = (Hub.BoxUp or isResetting())
			and (left == nil or left <= GUI_TRUST_WINDOW)

		if timeNear or guiNear then

			Hub.RideLeaving = true
			Hub.Riding = false
			for _ = 1, 3 do
				pcall(Hub.watchTreadmill)
				local done = Hub.clearTreadmillState(true)
				if done and Hub.TreadmillActive ~= true then break end
				task.wait(0.2)
			end
			Hub.PreResetUnequip = (Hub.PreResetUnequip or 0) + 1

			Hub.Phase = "ใกล้รีเซ็ต - ยืนรอที่จุดกลาง"
			move(warpHome)

			local t0 = os.clock()
			local hardStop = tonumber(Config.ResetWaitMax) or 90
			local sawFresh = false
			while os.clock() - t0 < hardStop do
				if not Config.Running or not alive() then return "หยุดกลางทาง" end

				if fieldIsFresh() then sawFresh = true end

				if sawFresh and not Hub.BoxUp and not isResetting() then break end

				settle(warpHome, 0.4)
			end

			local waited = os.clock() - t0
			if waited >= hardStop then
				log(("รอครบ %d วิแล้วยังไม่พร้อม (ไข่ใหม่=%s กล่อง=%s) - ออกไปลองเก็บเลย")
					:format(hardStop, tostring(sawFresh), tostring(Hub.BoxUp)))
			else
				log(("ไข่รีเซ็ตแล้วและกล่องหายแล้ว (รอไป %.1f วิ) - ออกไปเก็บ"):format(waited))
			end
			Hub.Phase = "รีเซ็ตจบ - ออกไปเก็บไข่"
			Hub.ResetSeenAt = os.clock()
			Hub.ResetWaits = (Hub.ResetWaits or 0) + 1
		end
	end

	if (Hub.BoxUp or isResetting()) and Config.MoveMode == "warp"
	   and Config.PreWarpOnReset == true and acPatched ~= false then
		local waitEgg = findEgg(Config.Area)
		if waitEgg then
			Hub.Phase = "ยืนทับไข่รอรีเซ็ตจบ"
			local _, _, hum0 = char()
			local hp0 = hum0 and hum0.Health or 100

			if move(waitEgg.BottomCFrame.Position + Vector3.new(0, 3, 0)) then
				local t0 = os.clock()
				while os.clock() - t0 < 120 do

					if not Config.Running or not alive() or fieldIsFresh() or Hub.quietNow() then break end

					local _, _, hum = char()
					if not hum or hum.Health < hp0 then
						log("โดนตีระหว่างยืนรอ - ถอยกลับเซฟโซน")
						break
					end

					local ok = Hub.rq(function(a) return carryF:InvokeServer(a) end,
						{ Uid = waitEgg.Uid })
					if ok == true then
						Stats.stolen += 1
						log(("ได้ไข่ทันทีที่รีเซ็ตจบ: %s ($%s/s)"):format(
							tostring(waitEgg.AssetCategory), comma(eggRate(waitEgg))))
						Hub.Phase = "วาปกลับ SAFE ZONE"
						move(warpHome)
						Hub.Phase = "เข้าแปลงวางไข่"
						tendBase()
						move(warpHome)
						Hub.Phase = "ยืนรอที่ SAFE ZONE"
						return nil
					end

					if not isResetting() then break end
					task.wait(0.12)
				end
			end
			move(warpHome)
		end
	end

	if not waitOutReset() then return "หยุดระหว่างรอรีเซ็ต" end

	local chainOn = (Config.MoveMode == "warp")
		and math.max(1, math.floor(tonumber(Config.ChainGrab) or 5)) > 1

	local stuck = 0
	if not chainOn then
		for _, rec in pairs(ownedEggs()) do
			if rec.Placement == nil then stuck = stuck + 1 end
		end
	end

	if stuck > 0 and Hub.placeBlocked() then stuck = 0 end

	if stuck > 0 then
		Hub.Phase = "มีไข่ค้าง - เอาไปวางก่อน"
		placePendingEggs()
		move(warpHome)

		local left = 0
		for _, rec in pairs(ownedEggs()) do
			if rec.Placement == nil then left = left + 1 end
		end
		Hub.notePlaceResult(left < stuck)
		if left > 0 then
			Hub.Phase = "วางไข่ที่ค้างไม่ลง"
			task.wait(1)
			return ("วางไข่ที่ค้างไม่ลง %d ฟอง (รังเต็มหรือหาที่ว่างไม่ได้)"):format(left)
		end
	end

	noteFieldReset()

	if resetStillSettling() then
		Hub.Phase = "รีเซ็ตเสร็จ - รอเซิร์ฟพร้อม"
		task.wait(0.2)
		return nil
	end

	if Hub.RideDoneAt and os.clock() - Hub.RideDoneAt > 300 then
		Hub.RideDoneAt = nil
		Hub.RideGateStuck = (Hub.RideGateStuck or 0) + 1
	end
	if Hub.RideDoneAt then
		Hub.Phase = "วิ่งครบรอบแล้ว - ยืนรอไข่ชุดใหม่"
		task.wait(0.5)
		return nil
	end

	if Config.CollectEggs == false then
		if baseNeedsWork() then
			Hub.Phase = "วิ่งอย่างเดียว - จัดการฐาน"
			tendBase()
			move(warpHome)
		end
		Hub.Phase = "วิ่งอย่างเดียว"

		if not Hub.rideIfWorth() then task.wait(1) end
		return nil
	end

	local egg, rate = findEgg(Config.Area)
	if not egg then return "ไม่มีไข่ว่างที่ " .. Config.Area end
	rate = rate or 0

	local worth, floorRate = worthGoing(rate)

	if Config.RunFirst then
		worth, floorRate = Hub.beatsPen(rate)
	else

		if fieldIsFresh() and Config.SkipWorseThanPen == false then worth = true end
	end
	if not worth then

		if baseNeedsWork() and not fieldIsFresh() and not Hub.quietNow() then
			Hub.Phase = "ไม่มีไข่คุ้ม - จัดการฐานแทน"
			tendBase()
			move(warpHome)
		end

		if Config.RunFirst then
			Hub.Phase = "เน้นวิ่ง - ไม่มีไข่แพงกว่าคอก ขึ้นไปวิ่งลู่"
			if not Hub.rideIfWorth() then

				local _, hR = char()
				if hR and (hR.Position - warpHome).Magnitude > 20 then move(warpHome) end
				task.wait(1)
			end
			return nil
		end

		local _, hIdle = char()
		if hIdle and (hIdle.Position - warpHome).Magnitude > 20 then
			Hub.Phase = "กลับไปยืนรอที่จุดกลาง"
			move(warpHome)
		end

		Hub.Phase = "รอไข่ดีๆ"
		task.wait(1)
		return ("รอไข่ดีกว่านี้ - ดีสุด $%s/s สู้ตัวอ่อนสุดในคอก ($%s/s) ไม่ได้")
			:format(comma(rate), comma(floorRate))
	end

	Hub.Phase = "กลับไปยืนกลาง SAFE ZONE"
	move(warpHome)

	local chainGrab = math.max(1, math.floor(tonumber(Config.ChainGrab) or 5))
	if fieldIsFresh() then
		chainGrab = math.max(chainGrab, math.floor(tonumber(Config.ChainGrabFresh) or 12))
	end
	if Config.MoveMode == "warp" and chainGrab > 1 then

		local queue = {}
		do
			local ranked = rankedEggs(Config.Area)
			for _, item in ipairs(ranked) do
				if #queue >= chainGrab * 2 then break end
				local okToTake = (fieldIsFresh() and Config.SkipWorseThanPen == false)
					or Config.SkipWeak == false
					or worthGoing(item.rate or 0)
				if okToTake then queue[#queue + 1] = item.rec end
			end
		end

		do
			local top = {}
			for i = 1, math.min(6, #queue) do
				top[i] = math.floor(eggRate(queue[i]) or 0)
			end
			Hub.QueueTop = top
			Hub.GotRates = {}
		end

		if #queue > 0 and Hub.ResetSeenAt and not Hub.GapEggSeen then
			Hub.GapEggSeen = os.clock() - Hub.ResetSeenAt
		end
		if #queue == 0 then

			local _, hq = char()
			if hq and (hq.Position - warpHome).Magnitude > 20 then
				Hub.Phase = "กลับไปยืนรอที่จุดกลาง"
				move(warpHome)
			end
			Hub.Phase = "รอไข่ดีๆ"
			task.wait(0.5)
			return "ไม่มีไข่คุ้มในสนาม"
		end

		local got, tried = 0, 0
		local qi = 0

		local eggRetry = {}
		local eggTail = {}

		local topUid = queue[1] and queue[1].Uid
		local topTries = 0

		local function chaseTop(egg, i)
			if not egg or egg.Uid ~= topUid then return false end
			if Config.ChaseTop == false then return false end

			topTries = topTries + 1
			if topTries > (tonumber(Config.ChaseTopRetries) or 8) then

				Hub.TopGaveUp = (Hub.TopGaveUp or 0) + 1
				return true
			end

			table.insert(queue, i + 1, egg)
			eggRetry[egg.Uid] = 0
			eggTail[egg.Uid] = nil
			Hub.TopChased = (Hub.TopChased or 0) + 1
			return true
		end

		while got < chainGrab and tried < chainGrab * 3 do
			if not Config.Running or not alive() then break end

			local nleft = Hub.nightIn()

			if Hub.resetWindow()
			   or (nleft ~= nil and nleft <= (tonumber(Config.PreResetHold) or 10)) then
				Hub.Phase = "ใกล้กลางคืน - เลิกเก็บ กลับไปรอที่จุดกลาง"
				move(warpHome)
				Hub.BoxAborts = (Hub.BoxAborts or 0) + 1
				break
			end

			tried = tried + 1

			qi = qi + 1
			local nextEgg = queue[qi]
			if not nextEgg then break end

			if Config.WatchBetter ~= false then
				local okr, live = pcall(rankedEggs, Config.Area)
				local best = okr and live and live[1]
				local bRec = best and best.rec
				if bRec and bRec.Uid ~= nextEgg.Uid
					and (eggRetry[bRec.Uid] or 0) == 0 then
					local mine = tonumber(eggRate(nextEgg)) or 0
					local ratio = tonumber(Config.BetterRatio) or 2

					if (tonumber(best.rate) or 0) > mine * ratio then
						table.insert(queue, qi + 1, nextEgg)
						nextEgg = bRec
						topUid = bRec.Uid
						topTries = 0
						Hub.Switched = (Hub.Switched or 0) + 1
						Hub.SwitchedTo = math.floor(best.rate or 0)
					end
				end
			end

			if Config.ViaHome ~= false then
				local _, hnow = char()
				if hnow and (hnow.Position - warpHome).Magnitude > 20 then
					Hub.Phase = "กลับกลางก่อนออกรอบใหม่"
					move(warpHome)
				end
			end

			Hub.Phase = ("วาปเก็บไข่ (%d/%d)"):format(got + 1, chainGrab)

			if not move(nextEgg.BottomCFrame.Position + Vector3.new(0, 3, 0)) then

				eggRetry[nextEgg.Uid] = (eggRetry[nextEgg.Uid] or 0) + 1
				if eggRetry[nextEgg.Uid] <= 1 then
					qi = qi - 1
				else

					if chaseTop(nextEgg, qi) then
						Hub.TopBack = (Hub.TopBack or 0) + 1
					elseif not eggTail[nextEgg.Uid] then
						eggTail[nextEgg.Uid] = true
						queue[#queue + 1] = nextEgg
						eggRetry[nextEgg.Uid] = 0
						Hub.EggRequeued = (Hub.EggRequeued or 0) + 1
					else
						Hub.SkipEgg = (Hub.SkipEgg or 0) + 1
					end
				end
				continue
			end

			local eggPos = nextEgg.BottomCFrame.Position + Vector3.new(0, 3, 0)
			if fieldIsFresh() or Hub.BoxUp then Hub.pinAt(eggPos, 2) end

			Hub.atEggOrRewarp(eggPos, function() return move(eggPos) end)

			do
				local wait0 = os.clock()
				while Hub.isTrapped() and os.clock() - wait0 < 8 do
					Hub.Phase = ("ติดกับดัก - รออีก %.1f วิ"):format(Hub.trappedFor())
					Hub.TrapWaits = (Hub.TrapWaits or 0) + 1
					task.wait(0.2)
				end
			end

			do
				local needSlow = tonumber(Config.SlowBeforeGrab) or 0.35
				local grabR = tonumber(Config.GrabRadius) or 8
				local gt0 = os.clock()
				while os.clock() - gt0 < 2 do
					local _, gh = char()
					if not gh then break end
					local gap = (gh.Position - eggPos).Magnitude
					local slowOk = needSlow <= 0
						or (Hub.SlowSince ~= nil and os.clock() - Hub.SlowSince >= needSlow)
					if gap <= grabR and slowOk then break end
					if gap > grabR then
						if not move(eggPos) then break end
					else

						Hub.NudgeCount = (Hub.NudgeCount or 0) + 1
						move(eggPos + Vector3.new(3, 0, 0))
						move(eggPos)
					end
				end
			end

			local ok, msg
			if Config.UsePrompt ~= false and Hub.grabPrompt(eggPos) then

				local t0 = os.clock()
				repeat
					task.wait()
					if Hub.isCarrying() then ok, msg = true, "prompt" break end
				until os.clock() - t0 > 0.25
				if ok then
					Hub.PromptOK = (Hub.PromptOK or 0) + 1
				else
					Hub.PromptMiss = (Hub.PromptMiss or 0) + 1
				end
			end

			if ok ~= true then
				ok, msg = Hub.callTimed(function(a)
					return carryF:InvokeServer(a)
				end, { Uid = nextEgg.Uid }, tonumber(Config.CallTimeout) or 4)

				if ok ~= true and tostring(msg):find("Already carrying") then
					if Hub.isCarrying() then
						ok, msg = true, "prompt (ยืนยันย้อนหลัง)"
						Hub.PromptLate = (Hub.PromptLate or 0) + 1
						Hub.PromptOK = (Hub.PromptOK or 0) + 1
						Hub.PromptMiss = math.max(0, (Hub.PromptMiss or 1) - 1)
					end
				end
			end

			Hub.LastCarryMsg = tostring(msg)
			if ok ~= true then
				Hub.CarryDenied = (Hub.CarryDenied or 0) + 1
				Hub.DenySeen = Hub.DenySeen or {}
				local k = tostring(msg)
				Hub.DenySeen[k] = (Hub.DenySeen[k] or 0) + 1
			end

			if ok ~= true and fieldIsFresh() and not tostring(msg):find("carrying") then

				Hub.Phase = "ยืนทับไข่รอเซิร์ฟปลดล็อก"
				local slice = math.max(0.5, tonumber(Config.HoldPerEgg) or 2.5)
				local total = math.max(2, tonumber(Config.ResetHoldFor) or 10)
				local deadline = os.clock() + math.min(slice, total)
				local n = 0
				while os.clock() < deadline do
					if not Config.Running or not alive() then break end
					task.wait(0.1)
					n = n + 1

					if n % 10 == 0 then
						move(nextEgg.BottomCFrame.Position + Vector3.new(0, 3, 0))

						clearSnapCacheFwd()
						local still = false
						for _, e in pairs(snapshot()) do
							if e.Uid == nextEgg.Uid then still = true break end
						end
						if not still then break end
					end
					Hub.pinAt(eggPos, 2)
					Hub.atEggOrRewarp(eggPos, function() return move(eggPos) end)
					ok, msg = Hub.callTimed(function(a)
						return carryF:InvokeServer(a)
					end, { Uid = nextEgg.Uid }, tonumber(Config.CallTimeout) or 4)
					if ok ~= true then Hub.LastCarryMsg = tostring(msg) end
					if ok == true or tostring(msg):find("carrying") then break end
				end
			end

			if ok == true then
				if Hub.ResetSeenAt and not Hub.GapFirstGrab then
					Hub.GapFirstGrab = os.clock() - Hub.ResetSeenAt
				end
				got = got + 1
				Stats.stolen += 1
				dropFromSnap(nextEgg.Uid)
				if type(Hub.GotRates) == "table" then
					Hub.GotRates[#Hub.GotRates + 1] = math.floor(eggRate(nextEgg) or 0)
				end

				pcall(Hub.pinRelease)

				Hub.Phase = "วาปกลับ SAFE ZONE ฝากไข่"
				local okBack = depositCarried(warpHome)

				if not okBack then
					Hub.DepositFail = (Hub.DepositFail or 0) + 1
					continue
				end
			elseif tostring(msg):find("carrying") then
				pcall(Hub.pinRelease)
				Hub.Phase = "วาปกลับ SAFE ZONE ฝากไข่"
				if not depositCarried(warpHome) then break end
			elseif tostring(msg):find("gameplay area") then
				task.wait(0.2)
				qi = qi - 1

			elseif Hub.resetWindow() then

				pcall(Hub.pinRelease)
				Hub.Phase = "ยังรีเซ็ตไม่จบ - กลับไปรอที่จุดกลาง"
				move(warpHome)
				Hub.BoxAborts = (Hub.BoxAborts or 0) + 1
				break

			elseif tostring(msg):find("unavailable") or tostring(msg):find("Unavailable")
				or tostring(msg):find("already claimed") then

				if tostring(msg):find("already claimed") and nextEgg.AreaId and nextEgg.NestId then

					Hub.ClaimSet = Hub.ClaimSet or {}
					Hub.ClaimSet[tostring(nextEgg.AreaId) .. ":" .. tostring(nextEgg.NestId)] = true
					Hub.ClaimLearned = (Hub.ClaimLearned or 0) + 1
				end

				eggRetry[nextEgg.Uid] = 99
				eggTail[nextEgg.Uid] = true

				local _, hNow = char()
				local here = hNow and hNow.Position

				local fresh = here and rankedEggs(Config.Area) or nil
				local bestRec, bestD, topRate = nil, math.huge, nil
				if fresh then
					for _, item in ipairs(fresh) do
						local rec = item.rec
						local rp = rec and rec.BottomCFrame and rec.BottomCFrame.Position

						if rp and (eggRetry[rec.Uid] or 0) == 0 then
							local rate = tonumber(item.rate) or 0
							if topRate == nil then topRate = rate end

							if rate < topRate * 0.99 then break end
							local d = (rp - here).Magnitude
							if d < bestD then bestD, bestRec = d, rec end
						end
					end
				end
				if bestRec then
					Hub.Retarget = (Hub.Retarget or 0) + 1

					queue[qi + 1] = bestRec
				else

					if chaseTop(nextEgg, qi) then
						Hub.TopBack = (Hub.TopBack or 0) + 1
					elseif not eggTail[nextEgg.Uid] then
						eggTail[nextEgg.Uid] = true
						queue[#queue + 1] = nextEgg
						eggRetry[nextEgg.Uid] = 0
						Hub.EggRequeued = (Hub.EggRequeued or 0) + 1
					else
						Hub.SkipEgg = (Hub.SkipEgg or 0) + 1
					end
				end

			elseif tostring(msg):find("trusted") then

				eggRetry[nextEgg.Uid] = (eggRetry[nextEgg.Uid] or 0) + 1
				if eggRetry[nextEgg.Uid] <= 1 then
					qi = qi - 1
				else

					if chaseTop(nextEgg, qi) then
						Hub.TopBack = (Hub.TopBack or 0) + 1
					elseif not eggTail[nextEgg.Uid] then
						eggTail[nextEgg.Uid] = true
						queue[#queue + 1] = nextEgg
						eggRetry[nextEgg.Uid] = 0
						Hub.EggRequeued = (Hub.EggRequeued or 0) + 1
					else
						Hub.SkipEgg = (Hub.SkipEgg or 0) + 1
					end
				end

			else

				local MAX_TRY = 1
				eggRetry[nextEgg.Uid] = (eggRetry[nextEgg.Uid] or 0) + 1
				if eggRetry[nextEgg.Uid] <= MAX_TRY then
					task.wait(0.12)
					qi = qi - 1
				else

					if chaseTop(nextEgg, qi) then
						Hub.TopBack = (Hub.TopBack or 0) + 1
					elseif not eggTail[nextEgg.Uid] then
						eggTail[nextEgg.Uid] = true
						queue[#queue + 1] = nextEgg
						eggRetry[nextEgg.Uid] = 0
						Hub.EggRequeued = (Hub.EggRequeued or 0) + 1
					else
						Hub.SkipEgg = (Hub.SkipEgg or 0) + 1
					end

					Hub.SkipReason = tostring(Hub.LastCarryMsg)
					Hub.SkipSeen = Hub.SkipSeen or {}
					local k = tostring(Hub.LastCarryMsg)
					Hub.SkipSeen[k] = (Hub.SkipSeen[k] or 0) + 1
				end
			end
		end

		Hub.Phase = "วาปกลับกลาง SAFE ZONE"
		move(warpHome)

		if got > 0 then

			local stillGood = false
			do
				local e, r = findEgg(Config.Area)
				if e then stillGood = (Config.SkipWeak == false) or worthGoing(r or 0) end
			end

			if equipBestF then
				pcall(function() equipBestF:InvokeServer() end)
				clearPetsCache()
			end

			local sn = math.max(0, math.floor(tonumber(Config.SellPerCycle) or 0))
			if not stillGood then
				pcall(autoSellWeak, false, sn > 0 and sn or nil)
			end

			local overflow = 0
			pcall(function()
				local pets = myPets()
				local keep = equipCap() + math.max(0, math.floor(Config.KeepExtra or 0))
				overflow = math.max(0, #pets - keep)
			end)
			if overflow >= 10 then
				Hub.Phase = ("คอกล้น %d ตัว - ขายทิ้ง"):format(overflow)
				pcall(autoSellWeak, true, sn > 0 and sn or nil)
			end

			warpRound = warpRound + 1
			local every = math.max(1, math.floor(tonumber(Config.TendEvery) or 5))

			local waiting = 0
			for _, rec in pairs(ownedEggs()) do
				if rec.Placement == nil then waiting = waiting + 1 end
			end

			local mustTend = (waiting >= chainGrab and not fieldIsFresh())
				or (warpRound % every == 0 and not stillGood)

			if mustTend then
				Hub.Phase = "เข้าแปลงจัดการฐาน"
				tendBase()

				if waiting >= chainGrab then
					Hub.Phase = "กระเป๋าไข่เต็ม - ฟักและวางให้หมด"

					pcall(hatchReadyEggs, nil, true)
					pcall(placePendingEggs)
				end
			else

				Hub.Phase = "เข้าแปลงฟักไข่ + วางไข่"

				local hn = math.max(0, math.floor(tonumber(Config.HatchPerCycle) or 0))
				hatchReadyEggs(hn > 0 and hn or nil)
				placePendingEggs()
			end
			move(warpHome)

			Hub.rideIfWorth()

			Hub.Phase = "ยืนรอที่ SAFE ZONE"
			return nil
		end

		Stats.failed += 1
		return "เก็บไม่สำเร็จในรอบนี้"
	end

	Hub.Phase = "วาปไปเก็บไข่"
	log(("เป้าหมาย: %s [%s] $%s/s"):format(egg.AssetCategory, egg.AreaId, comma(rate)))

	local got, lastMsg
	for attempt = 1, 3 do
		if not Config.Running then return "หยุดกลางทาง" end
		if not move(egg.BottomCFrame.Position + Vector3.new(0, 3, 0)) then
			lastMsg = "วาปไปไม่ถึง"
			break
		end

		local ok, msg = carryF:InvokeServer({ Uid = egg.Uid })
		if ok == true then got = egg break end
		lastMsg = tostring(msg)

		if lastMsg:find("gameplay area") then
			if attempt == 1 then
				task.wait(0.2)
			else
				enteredZone = false
				move(warpHome)
				if not ensureZone() then return "เข้าโซนเกมเพลย์ไม่ได้" end
			end
		else

			local nextEgg, nextRate = findEgg(Config.Area)
			if not nextEgg then break end
			egg, rate = nextEgg, nextRate or 0
		end
	end

	Hub.Phase = "วาปกลับ SAFE ZONE"
	move(warpHome)

	if not got then
		Stats.failed += 1
		return "เก็บไม่สำเร็จ: " .. tostring(lastMsg)
	end

	Stats.stolen += 1
	log(("เก็บได้: %s ($%s/s)"):format(got.AssetCategory or got.Uid, comma(eggRate(got))))

	warpRound = warpRound + 1
	local every = math.max(1, math.floor(tonumber(Config.TendEvery) or 5))

	if warpRound % every == 0 then
		Hub.Phase = "เข้าแปลงวางไข่ + จัดการฐาน"
		tendBase()
	else
		Hub.Phase = "เข้าแปลงวางไข่"
		placePendingEggs()
	end

	Hub.Phase = "วาปกลับกลาง SAFE ZONE"
	move(warpHome)

	Hub.Phase = "ยืนรอที่ SAFE ZONE"
	return nil
end

local function cycle()

	if Config.MoveMode == "warp" then
		return warpCycle()
	end

	Stats.cycles += 1

	if not waitForRespawn() then return "ตายแล้วไม่เกิดใหม่" end

	local home = homePos()
	if not home then return "หาแปลงของเราไม่เจอ" end

	Hub.Phase = "จัดการฐาน"
	tendBase()

	if not waitOutReset() then return "หยุดระหว่างรอรีเซ็ต" end

	local scout, scoutRate = findEgg(Config.Area)
	if not scout then return "ไม่มีไข่ว่างที่ " .. Config.Area end
	scoutRate = scoutRate or 0

	local worth, floorRate = worthGoing(scoutRate)
	if not worth then
		goIdle()
		Hub.Phase = "รอไข่ดีๆ"
		return ("รอไข่ดีกว่านี้ - ดีสุดในสนาม $%s/s ยังสู้ตัวอ่อนสุดในคอก ($%s/s) ไม่ได้")
			:format(comma(scoutRate), comma(floorRate))
	end

	local left = secondsToReset()
	if left and left < Config.TripReserve then
		goIdle()
		Hub.Phase = "รอรีเซ็ต"
		return ("อีก %ds จะรีเซ็ต - รอที่ฐานก่อน"):format(left)
	end

	Hub.Phase = "ออกเดินทาง"
	if not leaveBase() then return "ออกจากแปลงไม่สำเร็จ" end

	if not enterGameplayZone() then return "เข้าโซนเกมเพลย์ไม่ได้" end

	Hub.Phase = "ออกตัวช้าๆ"
	warmupRun()

	log(("เป้าหมาย: %s [%s] $%s/s"):format(
		scout.AssetCategory, scout.AreaId, comma(scoutRate)))

	move(Vector3.new(scout.BottomCFrame.Position.X - 40, LANE_Y, Hub.pickLaneZ()))

	pcall(baseCenter)

	Hub.Phase = "เก็บไข่"
	local got, lastMsg
	for _ = 1, 4 do
		if not Config.Running then return "หยุดกลางทาง" end
		local egg, rate = findEgg(Config.Area)
		if egg and not worthGoing(rate or 0) then
			lastMsg = "ฟองที่เหลือไม่คุ้ม เลิกรอบนี้"
			break
		end
		if not egg then
			lastMsg = "ไข่ถูกเก็บไปหมด"
			task.wait(1)
		else
			move(egg.BottomCFrame.Position + Vector3.new(0, 3, 0))
			local ok, msg = Hub.rq(function(a) return carryF:InvokeServer(a) end,
				{ Uid = egg.Uid })
			if ok == true then got = egg break end
			lastMsg = tostring(msg)
			task.wait(0.5)
		end
	end

	if not got then
		Stats.failed += 1
		goIdle()
		return "เก็บไม่สำเร็จ: " .. tostring(lastMsg)
	end
	log(("เก็บได้: %s ($%s/s)"):format(got.AssetCategory or got.Uid, comma(eggRate(got))))

	Hub.Phase = "พากลับฐาน"
	move(Vector3.new(got.BottomCFrame.Position.X, LANE_Y, Hub.pickLaneZ()))

	enterBase()
	task.wait(2)

	if carriedByMe() then return "ยังถือไข่อยู่ ยังไม่เข้าฐาน" end

	local still
	for _, r in pairs(snapshot()) do
		if r.Uid == got.Uid then still = r.State end
	end
	if still == "Slot" then
		Stats.failed += 1
		return "โดนการ์ดแย่งคืน (สปีดไม่พอสำหรับด่านนี้)"
	end

	Stats.stolen += 1
	Hub.Phase = "จัดการฐาน"
	tendBase()
	goIdle()
	return nil, true
end

