Hub.RemoteAt, Hub.RemoteLog = 0, {}
Hub.pace = function(gap)
	local minGap = tonumber(gap) or tonumber(Config.RemoteGap) or 0.10
	local burst = math.max(1, math.floor(tonumber(Config.RemoteBurst) or 8))

	local wait1 = (Hub.RemoteAt + minGap) - os.clock()
	if wait1 > 0 then
		Hub.RemotePaced = (Hub.RemotePaced or 0) + 1
		task.wait(wait1)
	end

	local now = os.clock()
	local keep = {}
	for _, t in ipairs(Hub.RemoteLog) do
		if now - t < 1 then keep[#keep + 1] = t end
	end
	Hub.RemoteLog = keep
	if #keep >= burst then
		local oldest = keep[1]
		local wait2 = (oldest + 1) - now
		if wait2 > 0 then
			Hub.RemoteThrottled = (Hub.RemoteThrottled or 0) + 1
			task.wait(wait2)
		end
	end

	Hub.RemoteAt = os.clock()
	Hub.RemoteLog[#Hub.RemoteLog + 1] = Hub.RemoteAt
	Hub.RemoteCount = (Hub.RemoteCount or 0) + 1
end

Hub.RemoteBusy = false
Hub.rq = function(fn, ...)
	local t0 = os.clock()
	while Hub.RemoteBusy and os.clock() - t0 < 6 do
		Hub.RemoteQueued = (Hub.RemoteQueued or 0) + 1
		task.wait(0.03)
	end

	Hub.RemoteBusy = true
	Hub.pace()

	local args = table.pack(...)
	local done, packed = false, nil
	task.spawn(function()
		packed = table.pack(pcall(fn, table.unpack(args, 1, args.n)))
		done = true
		Hub.RemoteBusy = false
	end)

	local limit = os.clock() + math.max(1, tonumber(Config.CallTimeout) or 4)
	while not done and os.clock() < limit do task.wait() end

	if not done then

		Hub.RemoteBusy = false
		Hub.RemoteHang = (Hub.RemoteHang or 0) + 1
		return nil
	end

	if not packed[1] then
		Hub.RemoteErr = (Hub.RemoteErr or 0) + 1
		return nil
	end
	return packed[2], packed[3]
end

