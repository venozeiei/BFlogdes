	local claimed = (Config.SkipClaimed ~= false) and Hub.claimedSlots() or {}
	local list = {}
	for _, r in pairs(snapshot()) do

		local st = r.State
		if (st == "Slot" or st == "Dropped") and (area == "ALL" or r.AreaId == area) then

			local key = (st == "Slot" and r.AreaId and r.NestId)
				and (tostring(r.AreaId) .. ":" .. tostring(r.NestId)) or nil
			if key and claimed[key] then
				Hub.SkipClaimed = (Hub.SkipClaimed or 0) + 1
			else
				list[#list + 1] = { rec = r, rate = eggRate(r) }
			end
		end
	end
	table.sort(list, function(a, b) return a.rate > b.rate end)
	return list
end

