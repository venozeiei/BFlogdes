Hub.checkNetwork = function()
	if Config.AutoNetMode == false then return end
	if Hub.NetChecked then return end
	Hub.NetChecked = true

	Hub.NetSave = {
		ImpulseBypass   = Config.ImpulseBypass,
		AdoptBaseline   = Config.AdoptBaseline,
		KillCorrections = Config.KillCorrections,
		PinHold         = Config.PinHold,
		FpsBoost        = Config.FpsBoost,
		ScanSlowLimit   = Config.ScanSlowLimit,
		RemoteGap       = Config.RemoteGap,
		RemoteBurst     = Config.RemoteBurst,
	}
	Hub.NetMode = "good"

	task.spawn(function()

		while true do
			local p = Hub.pingNow()
			if p then
				local t = Hub.NetPings
				t[#t + 1] = p
				while #t > 20 do table.remove(t, 1) end
			end

			local g, mid, jit, spike = Hub.netGrade()
			if g then
				Hub.NetPing, Hub.NetJitter, Hub.NetSpike = mid, jit, spike

				local rank = { good = 1, fair = 2, poor = 3 }
				local cur  = rank[Hub.NetMode] or 1
				local want = rank[g] or 1

				if want > cur then

					Hub.NetBetterAt = nil
					Hub.applyNet(g)
				elseif want < cur then

					Hub.NetBetterAt = Hub.NetBetterAt or os.clock()
					if os.clock() - Hub.NetBetterAt >= 60 then
						Hub.NetBetterAt = nil
						Hub.applyNet(g)
					end
				else
					Hub.NetBetterAt = nil
				end
			end

			task.wait(0.5)
		end
	end)
end

