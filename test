Hub.trapList = function()
	if os.clock() - (Hub.TrapScanAt or -1e9) < 3 then return Hub.Traps or {} end
	Hub.TrapScanAt = os.clock()
	local out = {}
	local added = {}

	local function take(d)
		if added[d] then return end
		added[d] = true

		out[#out + 1] = { p = d.Position, r = Hub.hazardRadiusOf(d), id = d }
	end

	local deb = workspace:FindFirstChild("__DEBRIS")
	if deb then
		for _, d in ipairs(deb:GetDescendants()) do
			if Hub.isHazardPart(d) then take(d) end
		end
	end

	for d in pairs(Hub.NewHazards) do
		if d.Parent == nil or not d:IsDescendantOf(workspace) then
			Hub.NewHazards[d] = nil
		elseif d.CanTouch then
			take(d)
		else

			Hub.NewHazards[d] = nil
		end
	end

	Hub.Traps = out
	Hub.TrapCount = #out
	return out
end

Hub.trapAt = function(pos)
	for _, t in ipairs(Hub.trapList()) do
		local dx, dz = pos.X - t.p.X, pos.Z - t.p.Z
		if (dx * dx + dz * dz) < (t.r * t.r) then return t end
	end
	return nil
end

Hub.guardParts = function()
	if os.clock() - (Hub.GuardScanAt or -1e9) < 5 then return Hub.GuardCols or {} end
	Hub.GuardScanAt = os.clock()

	local out = {}
	local function add(root)
		if not root then return end
		for _, g in ipairs(root:GetDescendants()) do
			if g:IsA("Model") and g.Name == "Guard" then
				local col = g:FindFirstChild("Collider")
				if col and col:IsA("BasePart") then out[#out + 1] = col end
			end
		end
	end

	local obj = workspace:FindFirstChild("__OBJECTS")
	local areas = obj and obj:FindFirstChild("Areas")
	add(areas and areas:FindFirstChild("GuardAreas"))
	add(workspace:FindFirstChild("_Guards"))

	Hub.GuardCols = out
	Hub.GuardCount = #out
	return out
end

Hub.guardAt = function(pos, dest)
	if Config.DodgeGuards == false then return nil end
	local extra = tonumber(Config.GuardMargin) or 8

	for _, c in ipairs(Hub.guardParts()) do
		if c.Parent then
			local p = c.Position
			local r = math.max(c.Size.X, c.Size.Z) * 0.5 + extra
			local dx, dz = pos.X - p.X, pos.Z - p.Z
			if (dx * dx + dz * dz) < (r * r) then

				local skip = false
				if typeof(dest) == "Vector3" then
					local ex, ez = dest.X - p.X, dest.Z - p.Z
					if (ex * ex + ez * ez) < (r * r) then skip = true end
				end
				if not skip then
					Hub.GuardDodged = (Hub.GuardDodged or 0) + 1
					return { p = p, r = r, id = c }
				end
			end
		end
	end
	return nil
end

Hub.hazardAt = function(pos, dest)
	return Hub.trapAt(pos) or Hub.guardAt(pos, dest)
end

Hub.hazardOnPath = function(from, to, dest)
	if typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then return nil end
	local d = to - from
	local m = d.Magnitude
	if m < 0.001 then return Hub.hazardAt(to, dest) end

	local step = math.max(1, tonumber(Config.HazardStep) or 4)
	local n = math.clamp(math.ceil(m / step), 1, 24)
	for i = 1, n do
		local hit = Hub.hazardAt(from + d * (i / n), dest)
		if hit then
			Hub.PathHits = (Hub.PathHits or 0) + 1
			return hit
		end
	end
	return nil
end

