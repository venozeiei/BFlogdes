	hatchReadyEggs()
	if stopped() then return end
	autoUpgradeBase()
	if stopped() then return end
	placePets()
	if stopped() then return end
	autoSellWeak()
	if stopped() then return end

	local waiting = 0
	for _, rec in pairs(ownedEggs()) do
		if rec.Placement == nil then waiting = waiting + 1 end
	end
	if waiting > 0 then
		placePendingEggs()

		if Hub.HOME then
			move(Vector3.new(Hub.HOME.X, Hub.HOME.Y, Hub.HOME.Z))
		end
	end
end

