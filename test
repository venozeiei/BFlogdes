Hub.netGrade = function()
	local t = Hub.NetPings
	if #t < 6 then return nil end

	local s = table.create(#t)
	for i = 1, #t do s[i] = t[i] end
	table.sort(s)

	local function at(frac)
		return s[math.clamp(math.ceil(#s * frac), 1, #s)]
	end

	local mid = at(0.5)

	local jit = at(0.9) - at(0.1)

	local spike = 0
	for i = 1, #t do
		if t[i] >= 0.5 then spike = spike + 1 end
	end

	local pf = tonumber(Config.NetPingFair)   or 0.12
	local pp = tonumber(Config.NetPingPoor)   or 0.30
	local jf = tonumber(Config.NetJitterFair) or 0.06
	local jp = tonumber(Config.NetJitterPoor) or 0.15

	if mid >= pp or jit >= jp or spike >= 2 then return "poor", mid, jit, spike end
	if mid >= pf or jit >= jf or spike >= 1 then return "fair", mid, jit, spike end
	return "good", mid, jit, spike
end

